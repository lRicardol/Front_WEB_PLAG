# Configuración para ejecutar el frontend contra el backend local (Back_Plang con perfil local).
# Copiar este archivo como .env:  cp .env.example .env
# No contiene secretos; el .env real no se sube al repositorio.

# Backend local (perfil local: API en la raíz, sin /api/v1)
VITE_API_BASE_URL=http://localhost:8080

# Chat en tiempo real (STOMP/WebSocket)
VITE_WS_BROKER_URL=ws://localhost:8080/ws-chat
